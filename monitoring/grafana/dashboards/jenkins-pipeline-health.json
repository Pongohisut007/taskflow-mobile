{
  "uid": "jenkins-pipeline-health",
  "title": "Jenkins Pipeline Health",
  "description": "Lab 09: build success rate, p95 build duration (SLO: < 6 min), and queue length.",
  "tags": ["jenkins", "slo", "lab09"],
  "timezone": "browser",
  "schemaVersion": 41,
  "version": 1,
  "refresh": "30s",
  "time": { "from": "now-3h", "to": "now" },
  "panels": [
    {
      "id": 1,
      "type": "stat",
      "title": "Build success rate",
      "description": "Successful builds / all builds in the selected time range, across every job.",
      "gridPos": { "x": 0, "y": 0, "w": 6, "h": 8 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        {
          "refId": "A",
          "expr": "(sum(increase(default_jenkins_builds_success_build_count_total[$__range])) or vector(0)) / sum(increase(default_jenkins_builds_total_build_count_total[$__range]))",
          "instant": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "decimals": 1,
          "min": 0,
          "max": 1,
          "noValue": "no builds in range",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "red", "value": null },
              { "color": "orange", "value": 0.8 },
              { "color": "green", "value": 0.95 }
            ]
          },
          "color": { "mode": "thresholds" }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false },
        "colorMode": "value",
        "graphMode": "none",
        "textMode": "value",
        "justifyMode": "center"
      }
    },
    {
      "id": 2,
      "type": "timeseries",
      "title": "p95 build duration (SLO: under 6 min)",
      "description": "95th percentile of build duration. The SLO '95% of builds under 6 minutes' holds while this stays below the dashed 6-minute line.",
      "gridPos": { "x": 6, "y": 0, "w": 9, "h": 8 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        { "refId": "A", "expr": "jenkins:build_duration_seconds:p95", "legendFormat": "p95 build duration" }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "min": 0,
          "color": { "mode": "fixed", "fixedColor": "blue" },
          "custom": {
            "drawStyle": "line",
            "lineWidth": 2,
            "fillOpacity": 0,
            "showPoints": "never",
            "thresholdsStyle": { "mode": "dashed" }
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "transparent", "value": null },
              { "color": "red", "value": 360 }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "legend": { "showLegend": false },
        "tooltip": { "mode": "single" }
      }
    },
    {
      "id": 3,
      "type": "timeseries",
      "title": "Current queue length",
      "description": "Builds waiting for an executor or agent pod. JenkinsQueueBacklog fires when this stays above 0 for 5 minutes.",
      "gridPos": { "x": 15, "y": 0, "w": 9, "h": 8 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        { "refId": "A", "expr": "jenkins_queue_size_value", "legendFormat": "queued builds" }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "none",
          "decimals": 0,
          "min": 0,
          "color": { "mode": "fixed", "fixedColor": "purple" },
          "custom": {
            "drawStyle": "line",
            "lineInterpolation": "stepAfter",
            "lineWidth": 2,
            "fillOpacity": 10,
            "showPoints": "never"
          }
        },
        "overrides": []
      },
      "options": {
        "legend": { "showLegend": false },
        "tooltip": { "mode": "single" }
      }
    }
  ]
}
